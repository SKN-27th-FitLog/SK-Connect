# --- .env.example ---
# 이 파일을 복사해서 .env 파일을 만드세요.
# 실제 비밀번호나 시크릿 키는 공유하지 않습니다.


# Database (PostgreSQL)
SERVICE_DB_NAME=service
DATA_DB_NAME=data

DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${SERVICE_DB_NAME}