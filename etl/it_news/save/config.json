{
  "timezone": "Asia/Seoul",
  "paths": {
    "cleaning_bucket": "cleaning",
    "save_bucket": "save",
    "thread_kind": "thread",
    "comment_kind": "comment",
    "success_dirname": "success",
    "fail_dirname": "fail",
    "csv_encoding": "utf-8-sig"
  },
  "db": {
    "connect_timeout": 10,
    "tables": {
      "crawling": "crawling",
      "comments": "comments"
    }
  },
  "limits": {
    "title": 200,
    "thread": 20,
    "article_url": 500,
    "author": 100,
    "category_cd": 6
  },
  "comments": {
    "default_status_cd": "ST01",
    "status_cd_max_length": 6,
    "user_id_env_keys": [
      "IT_NEWS_COMMENT_USER_ID",
      "COMMENT_USER_ID"
    ]
  }
}
